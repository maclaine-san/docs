{
  "name": "troupe",
  "productName": "Troupe",
  "version": "0.1.0",
  "description": "A macOS app for hiring a team of Claude agents, giving them roles, and letting them work together. Runs on your Claude subscription via the Claude Code CLI.",
  "main": "dist/main.js",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs && electron .",
    "start": "electron .",
    "typecheck": "tsc --noEmit",
    "test": "node build.mjs --tests && node --test dist-test/*.test.js",
    "e2e": "node build.mjs && node dist/e2e.js",
    "dist:mac": "node build.mjs && electron-builder --mac"
  },
  "build": {
    "appId": "dev.troupe.app",
    "productName": "Troupe",
    "files": [
      "dist/**",
      "!dist/e2e.js*",
      "!dist/**/*.map",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "directories": {
      "output": "release"
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.25.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.9.0"
  }
}
